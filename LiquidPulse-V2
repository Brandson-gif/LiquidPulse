    new("UICorner", {Parent = f, CornerRadius = UDim.new(1,0)})

    local dot = new("Frame", {
        Parent = s,
        Size = UDim2.new(0,12,0,12),
        Position = UDim2.new((def-min)/(max-min), -6, 0.5, -6),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        ZIndex = 10
    })
    new("UICorner", {Parent = dot, CornerRadius = UDim.new(1,0)})
    new("UIStroke", {
        Parent = dot,
        Color = Color3.fromRGB(40,40,40),
        Thickness = 2,
        ZIndex = 10
    })

    local draggingSlider = false
    local conn

    local function updateSlider(mousePos)
        if destroyed then return end

        local absolutePosition = s.AbsolutePosition
        local absoluteSize = s.AbsoluteSize
        local relativeX = math.clamp(
            mousePos.X - absolutePosition.X,
            0,
            absoluteSize.X
        )
        local pct = relativeX / absoluteSize.X

        f.Size = UDim2.new(pct, 0, 1, 0)
        dot.Position = UDim2.new(pct, -6, 0.5, -6)

        local v = math.floor((min + (max-min)*pct)*100)/100
        valueDisplay.Text = tostring(v)

        cb(v)
    end

    local function setValue(v)
        if destroyed then return end

        local pct = (v - min) / (max - min)
        f.Size = UDim2.new(pct, 0, 1, 0)
        dot.Position = UDim2.new(pct, -6, 0.5, -6)
        valueDisplay.Text = tostring(v)
    end

    local function startDrag(input)
        if destroyed then return end

        draggingSlider = true
        updateSlider(input.Position)

        conn = trackConnection(RunService.RenderStepped:Connect(function()
            if destroyed then
                draggingSlider = false
                return
            end

            if not draggingSlider then
                if conn then
                    conn:Disconnect()
                    conn = nil
                end
                return
            end

            updateSlider(UIS:GetMouseLocation())
        end))
    end

    local function endDrag()
        draggingSlider = false

        if conn then
            conn:Disconnect()
            conn = nil
        end
    end

    s.InputBegan:Connect(function(input)
        if destroyed then return end

        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            startDrag(input)
        end
    end)

    trackConnection(UIS.InputEnded:Connect(function(input)
        if destroyed then return end

        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            endDrag()
        end
    end))

    uiState.sliderCallbacks[lbl] = setValue
    return container
end

