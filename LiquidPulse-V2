-- ============================================================================
-- GLASS UI STATE & ANIMATIONS
-- ============================================================================
local Opened = false
local tweening = false
local dragging = false
local dragStart, startPos
local targetPos = CONFIG.Main.ClosedPos
local currentPos = targetPos
local currentSize = CONFIG.Main.ClosedSize

local closeOvershootTween, closeSettleTween

local function Open()
    if destroyed then return end
    if Opened then return end

    if tweening then
        if closeOvershootTween then
            closeOvershootTween:Cancel()
        end

        if closeSettleTween then
            closeSettleTween:Cancel()
        end

        closeOvershootTween = nil
        closeSettleTween = nil
        tweening = false
    end

    Opened = true
    tweening = true

    TopBar.Visible = true
    Backdrop.Visible = true

    TweenService:Create(
        BlurEffect,
        TweenInfo.new(
            CONFIG.Anim.Open.BlurDuration,
            CONFIG.Anim.Open.BlurEasing
        ),
        {Size = CONFIG.Blur.Size_Open}
    ):Play()

    TweenService:Create(
        Backdrop,
        TweenInfo.new(CONFIG.Anim.Open.BackdropDuration),
        {BackgroundTransparency = CONFIG.Backdrop.Transparency_Open}
    ):Play()

    TweenService:Create(
        Glow,
        TweenInfo.new(CONFIG.Anim.Open.GlowDuration),
        {
            Size = CONFIG.Glow.OpenSize,
            Position = CONFIG.Glow.OpenPos
        }
    ):Play()

    TweenService:Create(
        shadow,
        TweenInfo.new(CONFIG.Anim.Open.ShadowDuration),
        {
            Size = CONFIG.Shadow.OpenSize,
            Position = CONFIG.Shadow.OpenPos
        }
    ):Play()

    currentPos = CONFIG.Main.ClosedPos
    targetPos = UDim2.new(0.5, 0, 0.5, 0)
    currentSize = CONFIG.Main.OpenSize

    TweenService:Create(
        GearIcon,
        TweenInfo.new(CONFIG.Anim.Open.GearFadeDuration),
        {TextTransparency = 1}
    ):Play()

    TweenService:Create(
        Main,
        TweenInfo.new(
            CONFIG.Anim.Open.MainSizeDuration,
            CONFIG.Anim.Open.MainEasing,
            CONFIG.Anim.Open.MainEasingDir
        ),
        {Size = currentSize}
    ):Play()

    task.wait(CONFIG.Anim.Open.ContentFadeDelay)

    if destroyed then return end

    TweenService:Create(
        ContentGroup,
        TweenInfo.new(CONFIG.Anim.Open.ContentFadeDuration),
        {GroupTransparency = 0}
    ):Play()

    task.delay(CONFIG.Anim.Open.TweenLockDelay, function()
        if destroyed then return end
        tweening = false
    end)
end

local function CloseMenu()
    if destroyed then return end
    if not Opened or tweening then return end

    Opened = false
    tweening = true

    TopBar.Visible = false

    ContentGroup.GroupTransparency = 1
    ConfirmFrame.Visible = false
    GearIcon.TextTransparency = 0

    TweenService:Create(
        BlurEffect,
        TweenInfo.new(CONFIG.Anim.Close.BlurDuration),
        {Size = CONFIG.Blur.Size_Closed}
    ):Play()

    TweenService:Create(
        Backdrop,
        TweenInfo.new(CONFIG.Anim.Close.BackdropDuration),
        {BackgroundTransparency = CONFIG.Backdrop.Transparency_Closed}
    ):Play()

    TweenService:Create(
        Glow,
        TweenInfo.new(CONFIG.Anim.Close.GlowSettleDuration),
        {
            Size = CONFIG.Glow.ClosedSize,
            Position = CONFIG.Glow.ClosedPos,
            ImageTransparency = CONFIG.Glow.ImageTransparency_Closed,
        }
    ):Play()

    TweenService:Create(
        shadow,
        TweenInfo.new(CONFIG.Anim.Close.ShadowSettleDuration),
        {
            Size = CONFIG.Shadow.ClosedSize,
            Position = CONFIG.Shadow.ClosedPos,
        }
    ):Play()

    TweenService:Create(
        neonStroke,
        TweenInfo.new(CONFIG.Anim.Close.StrokeSettleDuration),
        {Transparency = 1}
    ):Play()

    TweenService:Create(
        neonCore,
        TweenInfo.new(CONFIG.Anim.Close.StrokeSettleDuration),
        {Transparency = 1}
    ):Play()

    TweenService:Create(
        outerStroke,
        TweenInfo.new(CONFIG.Anim.Close.StrokeSettleDuration),
        {
            Thickness = CONFIG.Main.OuterStroke.Thickness,
            Transparency = CONFIG.Main.OuterStroke.Transparency,
            Color = CONFIG.Main.OuterStroke.Color,
        }
    ):Play()

    local overshootPos = CONFIG.Anim.Close.OvershootPos

    closeOvershootTween = TweenService:Create(
        Main,
        TweenInfo.new(
            CONFIG.Anim.Close.OvershootDuration,
            CONFIG.Anim.Close.OvershootEasing,
            CONFIG.Anim.Close.OvershootDir
        ),
        {
            Position = overshootPos,
            Size = CONFIG.Main.ClosedSize,
        }
    )

    closeOvershootTween:Play()

    task.wait(0.3)

    if destroyed then return end

    closeSettleTween = TweenService:Create(
        Main,
        TweenInfo.new(
            CONFIG.Anim.Close.SettleDuration,
            CONFIG.Anim.Close.SettleEasing,
            CONFIG.Anim.Close.SettleDir
        ),
        {
            Position = CONFIG.Main.ClosedPos
        }
    )

    closeSettleTween:Play()
    closeSettleTween.Completed:Wait()

    if destroyed then return end

    currentPos = CONFIG.Main.ClosedPos
    targetPos = CONFIG.Main.ClosedPos

    closeOvershootTween = nil
    closeSettleTween = nil
    tweening = false
end

local function ToggleSize()
    if destroyed then return end
    if not Opened or tweening then return end

    tweening = true

    local newSize

    if currentSize == CONFIG.Main.OpenSize then
        newSize = CONFIG.Main.BigSize
    else
        newSize = CONFIG.Main.OpenSize
    end

    currentSize = newSize

    local scale =
        newSize.X.Offset / CONFIG.Main.OpenSize.X.Offset

    local glowSize =
        UDim2.new(1, 120 * scale, 1, 120 * scale)

    local glowPos =
        UDim2.new(0, -60 * scale, 0, -60 * scale)

    TweenService:Create(
        Glow,
        TweenInfo.new(0.6, Enum.EasingStyle.Quint),
        {
            Size = glowSize,
            Position = glowPos
        }
    ):Play()

    TweenService:Create(
        Main,
        TweenInfo.new(0.6, Enum.EasingStyle.Quint),
        {Size = newSize}
    ):Play()

    task.delay(0.6, function()
        if destroyed then return end
        tweening = false
    end)
end

local function DestroyConfirm()
    if destroyed then return end
    if not Opened or tweening then return end

    tweening = true

    TopBar.Visible = false
    ContentGroup.GroupTransparency = 1
    ConfirmFrame.Visible = true

    TweenService:Create(
        Main,
        TweenInfo.new(
            CONFIG.Anim.Confirm.ShrinkDuration,
            CONFIG.Anim.Confirm.ShrinkEasing
        ),
        {Size = CONFIG.ConfirmDialog.Size}
    ):Play()

    task.wait(CONFIG.Anim.Confirm.ShrinkDuration)

    if destroyed then return end

    tweening = false
end

local function RevertFromConfirm()
    if destroyed then return end
    if not Opened then return end

    tweening = true

    ConfirmFrame.Visible = false
    TopBar.Visible = true
    ContentGroup.GroupTransparency = 0

    TweenService:Create(
        Main,
        TweenInfo.new(
            CONFIG.Anim.Confirm.RevertDuration,
            CONFIG.Anim.Confirm.ShrinkEasing
        ),
        {Size = currentSize}
    ):Play()

    task.delay(CONFIG.Anim.Confirm.RevertDuration, function()
        if destroyed then return end
        tweening = false
    end)
end

-- ============================================================================
-- COMPLETE DESTROY / LIFECYCLE CLEANUP
-- ============================================================================
local function DestroyMenu()
    if destroyed then return end

    -- Flip the lifecycle flag first so every callback/loop immediately becomes
    -- a no-op.
    destroyed = true
    Opened = false
    tweening = false
    dragging = false

    aimbotEnabled = false
    ESP_ENABLED = false
    flyEnabled = false
    speedEnabled = false
    lockedTarget = nil

    -- Stop movement effects.
    for k in pairs(flyKeys) do
        flyKeys[k] = false
    end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if humanoid then
        humanoid.WalkSpeed = originalWalkSpeed
    end

    if root then
        root.Velocity = Vector3.zero
    end

    -- Hide and permanently remove every ESP Drawing object.
    hideAllESP()

    for _, data in pairs(box3DPool) do
        for _, line in ipairs(data.box) do
            pcall(function()
                line.Visible = false

                if line.Remove then
                    line:Remove()
                end
            end)
        end
    end

    for _, data in pairs(box2DPool) do
        for _, line in ipairs(data.box) do
            pcall(function()
                line.Visible = false

                if line.Remove then
                    line:Remove()
                end
            end)
        end
    end

    for _, data in pairs(linePool) do
        pcall(function()
            data.line.Visible = false

            if data.line.Remove then
                data.line:Remove()
            end
        end)
    end

    box3DPool = {}
    box2DPool = {}
    linePool = {}

    npcs = {}
    friendlyNPCs = {}
    hostileNPCs = {}

    -- Remove radar/blips.
    if radarBlips then
        for _, dot in pairs(radarBlips) do
            pcall(function()
                dot:Destroy()
            end)
        end

        radarBlips = {}
    end

    if radarFrame then
        pcall(function()
            radarFrame:Destroy()
        end)

        radarFrame = nil
    end

    -- IMPORTANT:
    -- Disconnect every external UIS / RunService / Player connection.
    -- This is what prevents ESP, keybinds, RenderStepped loops, fly/speed,
    -- aimbot, radar, etc. from continuing after destruction.
    disconnectAllConnections()

    -- Remove remaining UI state.
    pcall(function()
        TopBar.Visible = false
        ConfirmFrame.Visible = false
        ContentGroup.GroupTransparency = 1
        Backdrop.Visible = false
    end)

    -- Fade out the objects/effect.
    pcall(function()
        TweenService:Create(
            Backdrop,
            TweenInfo.new(CONFIG.Anim.Destroy.FadeDuration),
            {BackgroundTransparency = 1}
        ):Play()

        TweenService:Create(
            BlurEffect,
            TweenInfo.new(CONFIG.Anim.Destroy.FadeDuration),
            {Size = 0}
        ):Play()
    end)

    task.wait(CONFIG.Anim.Destroy.WaitBeforeDestroy)

    pcall(function()
        BlurEffect:Destroy()
    end)

    pcall(function()
        gui:Destroy()
    end)

    pcall(function()
        script:Destroy()
    end)
end

