local function getCharacterBounds(character)
    local parts = {}

    local function addPart(part)
        if part and part:IsA("BasePart") then
            table.insert(parts, part)
        end
    end

    addPart(character:FindFirstChild("Head"))
    addPart(character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso"))
    addPart(character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftUpperArm"))
    addPart(character:FindFirstChild("Right Arm") or character:FindFirstChild("RightUpperArm"))
    addPart(character:FindFirstChild("Left Leg") or character:FindFirstChild("LeftUpperLeg"))
    addPart(character:FindFirstChild("Right Leg") or character:FindFirstChild("RightUpperLeg"))
    addPart(character:FindFirstChild("HumanoidRootPart"))

    if #parts == 0 then
        return nil
    end

    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge

    for _, part in ipairs(parts) do
        local cf = part.CFrame
        local size = part.Size
        local half = size / 2

        local corners = {
            cf * Vector3.new(-half.X, -half.Y, -half.Z),
            cf * Vector3.new( half.X, -half.Y, -half.Z),
            cf * Vector3.new( half.X,  half.Y, -half.Z),
            cf * Vector3.new(-half.X,  half.Y, -half.Z),
            cf * Vector3.new(-half.X, -half.Y,  half.Z),
            cf * Vector3.new( half.X, -half.Y,  half.Z),
            cf * Vector3.new( half.X,  half.Y,  half.Z),
            cf * Vector3.new(-half.X,  half.Y,  half.Z),
        }

        for _, cornerPoint in ipairs(corners) do
            minX = math.min(minX, cornerPoint.X)
            minY = math.min(minY, cornerPoint.Y)
            minZ = math.min(minZ, cornerPoint.Z)

            maxX = math.max(maxX, cornerPoint.X)
            maxY = math.max(maxY, cornerPoint.Y)
            maxZ = math.max(maxZ, cornerPoint.Z)
        end
    end

    return Vector3.new(minX, minY, minZ), Vector3.new(maxX, maxY, maxZ)
end

local function create3DBox()
    local lines = {}

    for i = 1, 12 do
        local line = Drawing.new("Line")
        line.Thickness = BOX_THICKNESS
        line.Color = BOX_COLOR
        line.Visible = false
        lines[i] = line
    end

    return lines
end

local function get3DBox(inst)
    local data = box3DPool[inst]

    if data then
        data.lastUsed = tick()
        return data.box
    end

    local box = create3DBox()

    box3DPool[inst] = {
        box = box,
        lastUsed = tick()
    }

    return box
end

local function update3DBox(character, entityKey, isNPC)
    if destroyed then return end
    if not ESP_ENABLED or not ESP_MODES["3D Box"] then return end
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 then
        local data = box3DPool[entityKey]

        if data then
            for i=1,12 do
                data.box[i].Visible = false
            end
        end

        return
    end

    local minVec, maxVec = getCharacterBounds(character)

    if not minVec then
        return
    end

    local center = (minVec + maxVec) / 2
    local dist = (center - Camera.CFrame.Position).Magnitude

    if dist > ESP_MAX_DISTANCE then
        local data = box3DPool[entityKey]

        if data then
            for i=1,12 do
                data.box[i].Visible = false
            end
        end

        return
    end

    local box = get3DBox(entityKey)

    if not box then
        return
    end

    local color = Color3.fromRGB(255,0,0)

    if isNPC then
        if friendlyNPCs[entityKey] then
            color = Color3.fromRGB(0,255,0)
        elseif hostileNPCs[entityKey] then
            color = Color3.fromRGB(255,0,0)
        else
            color = Color3.fromRGB(255,165,0)
        end
    else
        if ESP_TEAM_CHECK
            and entityKey.Team
            and player.Team
            and entityKey.Team == player.Team then
            color = Color3.fromRGB(0,255,0)
        end
    end

    local corners = {
        Vector3.new(minVec.X, minVec.Y, minVec.Z),
        Vector3.new(maxVec.X, minVec.Y, minVec.Z),
        Vector3.new(maxVec.X, minVec.Y, maxVec.Z),
        Vector3.new(minVec.X, minVec.Y, maxVec.Z),
        Vector3.new(minVec.X, maxVec.Y, minVec.Z),
        Vector3.new(maxVec.X, maxVec.Y, minVec.Z),
        Vector3.new(maxVec.X, maxVec.Y, maxVec.Z),
        Vector3.new(minVec.X, maxVec.Y, maxVec.Z),
    }

    local edges = {
        {1,2},{2,3},{3,4},{4,1},
        {5,6},{6,7},{7,8},{8,5},
        {1,5},{2,6},{3,7},{4,8}
    }

    local anyVisible = false

    for i, edge in ipairs(edges) do
        local line = box[i]

        local p1, on1 = Camera:WorldToViewportPoint(corners[edge[1]])
        local p2, on2 = Camera:WorldToViewportPoint(corners[edge[2]])

        if on1 and on2 and p1.Z > 0 and p2.Z > 0 then
            line.From = Vector2.new(p1.X, p1.Y)
            line.To = Vector2.new(p2.X, p2.Y)
            line.Color = color
            line.Visible = true
            anyVisible = true
        else
            line.Visible = false
        end
    end

    if not anyVisible then
        for i=1,12 do
            box[i].Visible = false
        end
    end
end

local function create2DBoxLines()
    local box = {}

    if USE_CORNER_BOXES then
        for i=1,8 do
            local line = Drawing.new("Line")
            line.Thickness = BOX_THICKNESS
            line.Color = BOX_COLOR
            line.Visible = false
            box[i] = line
        end
    else
        for i=1,4 do
            local line = Drawing.new("Line")
            line.Thickness = BOX_THICKNESS
            line.Color = BOX_COLOR
            line.Visible = false
            box[i] = line
        end
    end

    return box
end

local function get2DBoxLines(inst)
