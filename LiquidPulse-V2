local mousemoverel = nil

if type(mousemoverel) == "function" then
elseif getgenv and type(getgenv().mousemoverel) == "function" then
    mousemoverel = getgenv().mousemoverel
elseif type(rawget(_G, "mousemoverel")) == "function" then
    mousemoverel = rawget(_G, "mousemoverel")
end

local function getPredictedPosition(target)
    if destroyed then return nil end
    if not target or not predictionEnabled then return nil end

    local rootPart = target.Character
        and target.Character:FindFirstChild("HumanoidRootPart")

    if not rootPart then
        return nil
    end

    local velocity = rootPart.Velocity

    if velocity.Magnitude < 0.1 then
        return nil
    end

    return rootPart.Position + velocity * predictionOffset
end

local function isTargetValid(target)
    if destroyed then return false end
    if not target then return false end
    if target == player then return false end
    if not target.Parent then return false end

    local character = target.Character

    if not character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 then
        return false
    end

    if teamCheckAimbot
        and target.Team
        and player.Team
        and target.Team == player.Team then

        return false
    end

    return true
end

local function getClosestPlayerToMouse()
    if destroyed then return nil end

    local closest = nil
    local closestDistance = MAX_AIM_DIST

    local mousePos = UIS:GetMouseLocation()

    for _, target in ipairs(Players:GetPlayers()) do
        if destroyed then return nil end

        if isTargetValid(target) then
            local character = target.Character
            local head = character and character:FindFirstChild("Head")

            if head then
                local screenPos, onScreen =
                    Camera:WorldToViewportPoint(head.Position)

                if onScreen and screenPos.Z > 0 then
                    local distance = (
                        Vector2.new(screenPos.X, screenPos.Y) - mousePos
                    ).Magnitude

                    if distance < closestDistance then
                        closestDistance = distance
                        closest = target
                    end
                end
            end
        end
    end

    return closest
end

local function cameraAimAt(target)
    if destroyed then return end
    if not target then return end

    local head = target.Character
        and target.Character:FindFirstChild("Head")

    if not head then
        return
    end

    local targetPos = head.Position
    local predicted = getPredictedPosition(target)

    if predicted then
        targetPos = predicted
    end

    local cameraPos = Camera.CFrame.Position
    local lookAt = CFrame.new(cameraPos, targetPos)

    Camera.CFrame = Camera.CFrame:Lerp(
        lookAt,
        math.clamp(aimSmoothness, 0.01, 1)
    )
end

local function mouseAimAt(target)
    if destroyed then return end
    if not mousemoverel then return end

    local head = target.Character
        and target.Character:FindFirstChild("Head")

    if not head then
        return
    end

    local targetPos = head.Position

    if predictionEnabled then
        local root = target.Character:FindFirstChild("HumanoidRootPart")

        if root then
            local predicted =
                root.Position + root.Velocity * predictionOffset

            local dist = (predicted - head.Position).Magnitude

            if dist < 10 then
                targetPos = predicted
            end
        end
    end

    local screenPos, onScreen =
        Camera:WorldToViewportPoint(targetPos)

    if onScreen and screenPos.Z > 0 then
        local mousePos = UIS:GetMouseLocation()

        local dx = screenPos.X - mousePos.X
        local dy = screenPos.Y - mousePos.Y

        if math.abs(dx) > 500 or math.abs(dy) > 500 then
            return
        end

        local smooth = math.clamp(aimSmoothness, 0.01, 1)

        dx = dx * smooth
        dy = dy * smooth

        mousemoverel(dx, dy)
    end
end

trackConnection(RunService.RenderStepped:Connect(function()
    if destroyed then return end

    if not aimbotEnabled then
        lockedTarget = nil
        return
    end

    if not (lockedTarget and isTargetValid(lockedTarget)) then
        lockedTarget = getClosestPlayerToMouse()
    end

    if lockedTarget then
        if aimbotMode == "Camera" then
            cameraAimAt(lockedTarget)
        else
            mouseAimAt(lockedTarget)
        end
    end
end))

