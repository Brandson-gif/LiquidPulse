end

local function update2DBox(character, entityKey, isNPC)
    if destroyed then return end
    if not ESP_ENABLED or not ESP_MODES["2D Box"] then return end
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 then
        local data = box2DPool[entityKey]

        if data then
            for _,line in ipairs(data.box) do
                line.Visible = false
            end
        end

        return
    end

    local parts = {
        character:FindFirstChild("Head"),
        character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso"),
        character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftUpperArm"),
        character:FindFirstChild("Right Arm") or character:FindFirstChild("RightUpperArm"),
        character:FindFirstChild("Left Leg") or character:FindFirstChild("LeftUpperLeg"),
        character:FindFirstChild("Right Leg") or character:FindFirstChild("RightUpperLeg"),
        character:FindFirstChild("HumanoidRootPart")
    }

    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local anyVisible = false

    for _, part in ipairs(parts) do
        if part then
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)

            if onScreen and screenPos.Z > 0 then
                anyVisible = true

                minX = math.min(minX, screenPos.X)
                minY = math.min(minY, screenPos.Y)
                maxX = math.max(maxX, screenPos.X)
                maxY = math.max(maxY, screenPos.Y)
            end
        end
    end

    if not anyVisible then
        local data = box2DPool[entityKey]

        if data then
            for _,line in ipairs(data.box) do
                line.Visible = false
            end
        end

        return
    end

    local root = character:FindFirstChild("HumanoidRootPart")

    if root then
        local dist = (root.Position - Camera.CFrame.Position).Magnitude

        if dist > ESP_MAX_DISTANCE then
            local data = box2DPool[entityKey]

            if data then
                for _,line in ipairs(data.box) do
                    line.Visible = false
                end
            end

            return
        end
    end

    local box = get2DBoxLines(entityKey)

    if not box then
        return
    end

    local color = Color3.fromRGB(255,0,0)

    if isNPC then
        if friendlyNPCs[entityKey] then
            color = Color3.fromRGB(0,255,0)
        elseif hostileNPCs[entityKey] then
            color = Color3.fromRGB(255,0,0)
        else
            color = Color3.fromRGB(255,165,0)
        end
    else
        if ESP_TEAM_CHECK
            and entityKey.Team
            and player.Team
            and entityKey.Team == player.Team then
            color = Color3.fromRGB(0,255,0)
        end
    end

    local pad = 4

    minX = minX - pad
    minY = minY - pad
    maxX = maxX + pad
    maxY = maxY + pad

    if USE_CORNER_BOXES then
        local cornerLen = math.clamp((maxX - minX) * 0.2, 8, 20)

        box[1].From = Vector2.new(minX, minY)
        box[1].To = Vector2.new(minX + cornerLen, minY)

        box[2].From = Vector2.new(minX, minY)
        box[2].To = Vector2.new(minX, minY + cornerLen)

        box[3].From = Vector2.new(maxX, minY)
        box[3].To = Vector2.new(maxX - cornerLen, minY)

        box[4].From = Vector2.new(maxX, minY)
        box[4].To = Vector2.new(maxX, minY + cornerLen)

        box[5].From = Vector2.new(minX, maxY)
        box[5].To = Vector2.new(minX + cornerLen, maxY)

        box[6].From = Vector2.new(minX, maxY)
        box[6].To = Vector2.new(minX, maxY - cornerLen)

        box[7].From = Vector2.new(maxX, maxY)
        box[7].To = Vector2.new(maxX - cornerLen, maxY)

        box[8].From = Vector2.new(maxX, maxY)
        box[8].To = Vector2.new(maxX, maxY - cornerLen)

        for i=1,8 do
            box[i].Color = color
            box[i].Visible = true
        end
    else
        box[1].From = Vector2.new(minX, minY)
        box[1].To = Vector2.new(maxX, minY)

        box[2].From = Vector2.new(maxX, minY)
        box[2].To = Vector2.new(maxX, maxY)

        box[3].From = Vector2.new(maxX, maxY)
        box[3].To = Vector2.new(minX, maxY)

        box[4].From = Vector2.new(minX, maxY)
        box[4].To = Vector2.new(minX, minY)

        for i=1,4 do
            box[i].Color = color
            box[i].Visible = true
        end
    end
end

local function createLine()
    local line = Drawing.new("Line")
    line.Thickness = 2
    line.Visible = false
    return line
end

local function getLine(inst)
    local data = linePool[inst]

    if data then
        data.lastUsed = tick()
        return data.line
    end

    local line = createLine()

    linePool[inst] = {
        line = line,
        lastUsed = tick()
    }

    return line
end

local function updateLine(character, entityKey, isNPC)
    if destroyed then return end
    if not ESP_ENABLED or not ESP_MODES["Line"] then return end

    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    local line = getLine(entityKey)
    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)

    if onScreen and screenPos.Z > 0 then
        line.From = Vector2.new(
            Camera.ViewportSize.X/2,
            Camera.ViewportSize.Y
        )

        line.To = Vector2.new(screenPos.X, screenPos.Y)

        if isNPC then
            line.Color = Color3.fromRGB(255,165,0)
        elseif ESP_TEAM_CHECK
            and entityKey.Team
            and player.Team
            and entityKey.Team == player.Team then
            line.Color = Color3.fromRGB(0,255,0)
        else
            line.Color = Color3.fromRGB(255,0,0)
        end

        line.Visible = true
    else
        line.Visible = false
    end
end

