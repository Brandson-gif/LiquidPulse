local function updateRadarGUI()
    if destroyed then return end
    if not radarFrame then return end

    radarFrame.Visible = ESP_ENABLED and ESP_MODES["Radar"]

    if not radarFrame.Visible then
        for _, dot in pairs(radarBlips) do
            dot.Visible = false
        end

        if localArrow then
            localArrow.Visible = false
        end

        return
    end

    local localChar = player.Character

    if not localChar then
        return
    end

    local localRoot = localChar:FindFirstChild("HumanoidRootPart")

    if not localRoot then
        return
    end

    local localPos = localRoot.Position
    local halfRadar = radarSize / 2
    local scale = radarRange / halfRadar

    local camDir = Camera.CFrame.LookVector
    local angle = math.atan2(camDir.X, -camDir.Z)

    if localArrow then
        localArrow.Visible = true
        localArrow.Rotation = math.deg(angle)
    end

    local function updateBlip(blipFrame, worldPos, color)
        if destroyed then return end

        local delta = worldPos - localPos
        delta = Vector3.new(delta.X, 0, delta.Z)

        local dist = delta.Magnitude

        if dist > radarRange then
            blipFrame.Visible = false
            return
        end

        local radarPos = Vector2.new(delta.X, delta.Z) / scale

        radarPos = Vector2.new(
            radarPos.X,
            radarPos.Y
        )

        local x = halfRadar + radarPos.X
        local y = halfRadar + radarPos.Y

        blipFrame.Position = UDim2.fromOffset(x, y)
        blipFrame.Visible = true
        blipFrame.BackgroundColor3 = color
    end

    local function getBlip(entityKey)
        if destroyed then return nil end

        if radarBlips[entityKey] then
            return radarBlips[entityKey]
        end

        local dot = new("Frame", {
            Parent = radarFrame,
            Size = UDim2.fromOffset(8,8),
            AnchorPoint = Vector2.new(0.5,0.5),
            BackgroundColor3 = Color3.fromRGB(255,0,0),
            BorderSizePixel = 0,
            ZIndex = 18
        })

        new("UICorner", {
            CornerRadius = UDim.new(1,0),
            Parent = dot
        })

        radarBlips[entityKey] = dot

        return dot
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if destroyed then return end

        if plr ~= player then
            local char = plr.Character

            if char then
                local root = char:FindFirstChild("HumanoidRootPart")

                if root then
                    local color = Color3.fromRGB(255,0,0)

                    if ESP_TEAM_CHECK
                        and plr.Team
                        and player.Team
                        and plr.Team == player.Team then

                        color = Color3.fromRGB(0,255,0)
                    end

                    local blip = getBlip(plr)

                    if blip then
                        updateBlip(blip, root.Position, color)
                    end
                end
            end
        end
    end

    if detectNPCs then
        for _, npc in ipairs(npcs) do
            if destroyed then return end

            local root = npc:FindFirstChild("HumanoidRootPart")

            if root then
                local color = Color3.fromRGB(255,165,0)

                if friendlyNPCs[npc] then
                    color = Color3.fromRGB(0,255,0)
                elseif hostileNPCs[npc] then
                    color = Color3.fromRGB(255,0,0)
                end

                local blip = getBlip(npc)

                if blip then
                    updateBlip(blip, root.Position, color)
                end
            end
        end
    end

    for entityKey, dot in pairs(radarBlips) do
        if dot.Visible then
            local valid = false

            if typeof(entityKey) == "Instance" then
                if entityKey:IsA("Player") and entityKey.Parent then
                    valid = true
                end

                if entityKey:IsA("Model") and entityKey.Parent then
                    valid = true
                end
            end

            if not valid then
                dot.Visible = false
            end
        end
    end
end

