-- ============================================================================
-- GLOBAL KEYBINDS
-- ============================================================================
trackConnection(UIS.InputBegan:Connect(function(input, gp)
    if destroyed or gp then return end

    if input.KeyCode == menuKey then
        if Opened then
            CloseMenu()
        else
            Open()
        end

        return
    end

    local key = input.KeyCode

    if key == aimbotKey then
        aimbotEnabled = not aimbotEnabled

        if uiState.toggleCallbacks["Aimbot"] then
            uiState.toggleCallbacks["Aimbot"](aimbotEnabled, true)
        end

        notify("Aimbot " .. (aimbotEnabled and "ON" or "OFF"))

    elseif key == espKey then
        ESP_ENABLED = not ESP_ENABLED

        if uiState.toggleCallbacks["ESP"] then
            uiState.toggleCallbacks["ESP"](ESP_ENABLED, true)
        end

        notify("ESP " .. (ESP_ENABLED and "ON" or "OFF"))

    elseif key == flyKey then
        flyEnabled = not flyEnabled

        if uiState.toggleCallbacks["Fly"] then
            uiState.toggleCallbacks["Fly"](flyEnabled, true)
        end

        if not flyEnabled then
            for k in pairs(flyKeys) do
                flyKeys[k] = false
            end
        end

        notify("Fly " .. (flyEnabled and "ON" or "OFF"))

    elseif key == speedKey then
        speedEnabled = not speedEnabled

        if uiState.toggleCallbacks["Speed"] then
            uiState.toggleCallbacks["Speed"](speedEnabled, true)
        end

        notify("Speed " .. (speedEnabled and "ON" or "OFF"))
    end
end))

-- ============================================================================
-- DRAGGING
-- ============================================================================
TopBar.InputBegan:Connect(function(input)
    if destroyed then return end
    if not Opened or tweening then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = targetPos

        TweenService:Create(
            Glow,
            TweenInfo.new(
                CONFIG.Anim.Drag.GlowTransitionDuration,
                Enum.EasingStyle.Quad
            ),
            {
                ImageTransparency = CONFIG.Glow.ImageTransparency_Drag,
                Size = CONFIG.Glow.DragSize,
                Position = CONFIG.Glow.DragPos,
            }
        ):Play()

        TweenService:Create(
            neonStroke,
            TweenInfo.new(CONFIG.Anim.Drag.NeonFadeInDuration),
            {Transparency = 0.7}
        ):Play()

        TweenService:Create(
            neonCore,
            TweenInfo.new(CONFIG.Anim.Drag.NeonFadeInDuration),
            {Transparency = 0}
        ):Play()

        TweenService:Create(
            outerStroke,
            TweenInfo.new(CONFIG.Anim.Drag.OuterStrokeFadeDuration),
            {
                Thickness = 0,
                Transparency = 1
            }
        ):Play()

        input.Changed:Connect(function()
            if destroyed then return end

            if input.UserInputState == Enum.UserInputState.End then
                dragging = false

                TweenService:Create(
                    Glow,
                    TweenInfo.new(
                        CONFIG.Anim.Drag.NeonFadeOutDuration,
                        Enum.EasingStyle.Quad
                    ),
                    {
                        ImageTransparency = CONFIG.Glow.ImageTransparency_Closed,
                        Size = CONFIG.Glow.OpenSize,
                        Position = CONFIG.Glow.OpenPos,
                    }
                ):Play()

                TweenService:Create(
                    neonStroke,
                    TweenInfo.new(CONFIG.Anim.Drag.NeonFadeOutDuration),
                    {Transparency = 1}
                ):Play()

                TweenService:Create(
                    neonCore,
                    TweenInfo.new(CONFIG.Anim.Drag.NeonFadeOutDuration),
                    {Transparency = 1}
                ):Play()

                TweenService:Create(
                    outerStroke,
                    TweenInfo.new(CONFIG.Anim.Drag.NeonFadeOutDuration),
                    {
                        Thickness = CONFIG.Main.OuterStroke.Thickness,
                        Transparency = CONFIG.Main.OuterStroke.Transparency,
                        Color = CONFIG.Main.OuterStroke.Color,
                    }
                ):Play()
            end
        end)
    end
end)

trackConnection(UIS.InputChanged:Connect(function(input)
    if destroyed then return end

    if dragging
        and input.UserInputType == Enum.UserInputType.MouseMovement then

        local delta = input.Position - dragStart

        targetPos = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end))

-- ============================================================================
-- MAIN UI RENDER LOOP
-- ============================================================================
local timeValue = 0

trackConnection(RunService.RenderStepped:Connect(function(dt)
    if destroyed then return end

    timeValue += dt

    if Opened then
        currentPos = currentPos:Lerp(
            targetPos,
            math.clamp(
                dt * CONFIG.Anim.LerpSpeed,
                0,
                1
            )
        )

        Main.Position = currentPos

        local dx =
            targetPos.X.Offset - currentPos.X.Offset

        Main.Rotation =
            math.clamp(dx * 0.018, -3.5, 3.5)
    else
        Main.Rotation =
            math.sin(timeValue * 1.05) * 1.7
    end
end))
