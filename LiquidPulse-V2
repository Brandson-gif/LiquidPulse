local function createTab(name)
    local btn = new("TextButton",{
        Parent=tabBar,
        Size=UDim2.fromOffset(90,34),
        BackgroundColor3=Color3.fromRGB(30,30,35),
        BackgroundTransparency=0.4,
        Text=name,
        Font=Enum.Font.GothamMedium,
        TextSize=13,
        TextColor3=Color3.fromRGB(170,170,180),
        ZIndex=102
    })
    new("UICorner",{CornerRadius=UDim.new(1,0),Parent=btn})
    local glow = new("UIStroke",{Parent=btn,Transparency=1,Thickness=1,ZIndex=102})

    local page = new("Frame",{
        Parent = holder,
        Size = UDim2.new(1,0,1,0),
        Position = UDim2.new(0,0,0,0),
        BackgroundTransparency = 1,
        Visible = false,
        ZIndex = 10
    })

    local tabData = { button = btn, page = page, glow = glow }
    table.insert(tabs, tabData)

    btn.MouseButton1Click:Connect(function()
        if destroyed then return end

        for _, t in ipairs(tabs) do
            t.page.Visible = false
            TweenService:Create(t.button, TweenInfo.new(0.25), {
                BackgroundTransparency = 0.4,
                TextColor3 = Color3.fromRGB(170,170,180)
            }):Play()
            TweenService:Create(t.glow, TweenInfo.new(0.25), {Transparency = 1}):Play()
        end

        page.Visible = true
        TweenService:Create(btn, TweenInfo.new(0.25), {
            BackgroundTransparency = 0.15,
            TextColor3 = Color3.new(1,1,1)
        }):Play()
        TweenService:Create(glow, TweenInfo.new(0.25), {
            Transparency = 0.6,
            Color = Color3.fromRGB(80,140,255)
        }):Play()
        currentTab = tabData
    end)

    return page
end

