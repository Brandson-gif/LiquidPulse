local function createSwitchInScroll(parent, text, defaultState, callback)
    local island = new("Frame",{
        Parent=parent,
        Size=UDim2.new(0.9,0,0,60),
        BackgroundColor3=Color3.fromRGB(40,40,48),
        BackgroundTransparency=0.2,
        ZIndex=10
    })
    new("UICorner",{CornerRadius=UDim.new(0,18),Parent=island})
    new("UIStroke",{Transparency=0.9,Parent=island,ZIndex=10})

    new("TextLabel",{
        Parent=island,
        Position=UDim2.fromOffset(15,0),
        Size=UDim2.new(0.6,0,1,0),
        BackgroundTransparency=1,
        Text=text,
        Font=Enum.Font.GothamMedium,
        TextSize=15,
        TextColor3=Color3.fromRGB(230,230,240),
        TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=10
    })

    local toggle = new("Frame",{
        Parent=island,
        Size=UDim2.fromOffset(50,26),
        Position=UDim2.new(1,-65,0.5,-13),
        BackgroundColor3=Color3.fromRGB(100,100,110),
        ZIndex=10
    })
    new("UICorner",{CornerRadius=UDim.new(1,0),Parent=toggle})

    local knob = new("Frame",{
        Parent=toggle,
        Size=UDim2.fromOffset(22,22),
        Position=UDim2.fromOffset(2,2),
        BackgroundColor3=Color3.new(1,1,1),
        ZIndex=10
    })
    new("UICorner",{CornerRadius=UDim.new(1,0),Parent=knob})

    local on = defaultState or false

    local function updateToggle(state, skipCallback, force)
        if destroyed then return end
        if not force and state == on then return end

        on = state

        local targetPos = on and UDim2.new(1,-24,0,2) or UDim2.fromOffset(2,2)
        local targetColor = on and Color3.fromRGB(60,200,120) or Color3.fromRGB(100,100,110)

        TweenService:Create(
            knob,
            TweenInfo.new(0.25,Enum.EasingStyle.Quint),
            {Position = targetPos}
        ):Play()

        TweenService:Create(
            toggle,
            TweenInfo.new(0.25),
            {BackgroundColor3 = targetColor}
        ):Play()

        if callback and not skipCallback then
            callback(on)
        end
    end

    toggle.InputBegan:Connect(function(i)
        if destroyed then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            updateToggle(not on)
        end
    end)

    updateToggle(on, true, true)
    uiState.toggleCallbacks[text] = updateToggle

    return island, updateToggle
end

local function createCycleButtonInScroll(parent, text, options, default, callback)
    local btn = new("TextButton", {
        Parent = parent,
        Size = UDim2.new(0.9,0,0,36),
        Text = text .. ": " .. default,
        Font = Enum.Font.GothamMedium,
        TextSize = 14,
        TextColor3 = Color3.fromRGB(230,230,240),
        BackgroundColor3 = Color3.fromRGB(40,40,48),
        AutoButtonColor = false,
        ZIndex = 10
    })

    new("UICorner", {CornerRadius = UDim.new(0,12), Parent = btn})
    new("UIStroke", {Transparency = 0.85, Parent = btn, ZIndex = 10})

    local index = 1
    for i, opt in ipairs(options) do
        if opt == default then
            index = i
            break
        end
    end

    local function setOption(newOption)
        if destroyed then return end
        btn.Text = text .. ": " .. newOption
        callback(newOption)
    end

    btn.MouseButton1Click:Connect(function()
        if destroyed then return end

        index = index + 1
        if index > #options then index = 1 end

        setOption(options[index])
    end)

    uiState.cycleCallbacks[text] = setOption
    return btn
end

