trackConnection(RunService.RenderStepped:Connect(function()
    if destroyed then return end

    local char = player.Character

    if not char then
        return
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")

    if not root or not hum then
        return
    end

    if flyEnabled then
        local speed = originalWalkSpeed * speedMultiplier

        if flyMode == "WSAD" then
            local move = Vector3.new()
            local cam = Camera.CFrame

            if flyKeys.W then
                move += cam.LookVector * Vector3.new(1,0,1)
            end

            if flyKeys.S then
                move -= cam.LookVector * Vector3.new(1,0,1)
            end

            if flyKeys.D then
                move += cam.RightVector
            end

            if flyKeys.A then
                move -= cam.RightVector
            end

            if move.Magnitude > 0 then
                move = move.Unit * speed
            end

            local y = 0

            if flyKeys.Space then
                y = speed
            end

            if flyKeys.Shift then
                y = -speed
            end

            root.Velocity = Vector3.new(move.X, y, move.Z)
        else
            local lv = Camera.CFrame.LookVector
            local desired = Vector3.new(lv.X, 0, lv.Z)

            if desired.Magnitude > 0 then
                desired = desired.Unit * speed
            end

            local y = 0

            if flyKeys.Space then
                y = speed
            end

            if flyKeys.Shift then
                y = -speed
            end

            root.Velocity = Vector3.new(desired.X, y, desired.Z)
        end
    end

    if speedEnabled then
        hum.WalkSpeed = originalWalkSpeed * speedMultiplier
    else
        hum.WalkSpeed = originalWalkSpeed
    end
end))

